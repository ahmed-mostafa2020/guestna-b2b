{
  "permissions": {
    "allow": [
      "Bash(yarn lint*)",
      "Bash(yarn eslint *)",
      "Bash(npx eslint *)",
      "Bash(yarn prettier --check *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./out/**)",
      "Read(./dist/**)",
      "Read(./coverage/**)",
      "Read(./yarn.lock)",
      "Read(./package-lock.json)",
      "Read(./pnpm-lock.yaml)",
      "Read(./.env*)",
      "Read(./public/sw.js)",
      "Read(./public/workbox-*.js)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.js\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -Command '[console]::beep(1000,300)'"
          }
        ]
      }
    ]
  }
}
